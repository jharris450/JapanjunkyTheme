{%- comment -%}
  Toolbox — bottom-right fan menu of media-player tools. Tranche 1 renders the
  button + fan only; dragging a tool to spawn a player arrives in Tranche 2.
  Every tool shows its rendered model icon (assets/jj-icon-<tool>.png, built by
  tools/blender/build.py: the unit shut, at the player's quarter camera).
{%- endcomment -%}
<div class="jj-toolbox" id="jj-toolbox">
  <div class="jj-toolbox__fan" id="jj-toolbox-fan" aria-label="Media players toolbox" hidden>
    <button type="button" class="jj-toolbox__tool" data-tool="record"
            aria-label="Record player" title="Record player">
      <img class="jj-toolbox__tool-icon" src="{{ 'jj-icon-record.png' | asset_url }}" alt="" width="64" height="64">
    </button>
    <button type="button" class="jj-toolbox__tool" data-tool="cassette"
            aria-label="Cassette Walkman" title="Cassette Walkman">
      <img class="jj-toolbox__tool-icon" src="{{ 'jj-icon-cassette.png' | asset_url }}" alt="" width="64" height="64">
    </button>
    <button type="button" class="jj-toolbox__tool" data-tool="cd"
            aria-label="CD Walkman" title="CD Walkman">
      <img class="jj-toolbox__tool-icon" src="{{ 'jj-icon-cd.png' | asset_url }}" alt="" width="64" height="64">
    </button>
  </div>
  <button type="button" class="jj-toolbox__btn" id="jj-toolbox-btn"
          aria-expanded="false" aria-controls="jj-toolbox-fan" aria-label="Open media players">
    <span class="jj-toolbox__btn-glyph" aria-hidden="true">&#9834;</span>
  </button>
</div>
